<?xml version="1.0"?>
<robot name="movensys_manipulator" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="wmx_param_file"
             default="$(find wmx_r2_package)/config/cr3a_wmx_parameters.xml"/>

  <!-- Export 'position' command interfaces and stream them through the WMX3
       cyclic buffer. Set false for the previous feedback-only behaviour; see
       cr3a.wmx.ros2_control.xacro. -->
  <xacro:arg name="stream_position" default="true"/>

  <xacro:include filename="$(find movensys_manipulator_description)/urdf/dobot_cr3a/movensys_manipulator.xacro"/>
  <xacro:include filename="$(find wmx_r2_control)/urdf/cr3a.wmx.ros2_control.xacro"/>

  <xacro:movensys_manipulator_arm_wmx_r2_control
      name="WmxManipulatorArmSystem"
      wmx_param_file="$(arg wmx_param_file)"
      stream_position="$(arg stream_position)"/>

</robot>
