<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    ros2_control description for the Dobot CR3A arm backed by the WMX3 EtherCAT
    motion controller.

    The arm joints are STATE-ONLY here: their trajectory is executed by the
    standalone joint_trajectory_controller node (AdvancedMotion C-Spline, from
    wmx_ros2_package), exactly as in the non-ros2_control launch. ros2_control is
    used only to publish encoder feedback via joint_state_broadcaster, so each
    joint exposes position/velocity state interfaces and NO command interface.

    The gripper (picker_1_joint / picker_2_joint) is likewise outside this
    system — driven over digital IO by the standalone gripper_controller node.
  -->
  <xacro:macro name="movensys_manipulator_arm_wmx_ros2_control"
               params="name:=WmxManipulatorArmSystem
                       wmx_param_file">

    <ros2_control name="${name}" type="system">
      <hardware>
        <plugin>wmx_ros2_control/WmxSystemHardware</plugin>
        <param name="device_name">wmx_cr3a_control</param>
        <param name="wmx_param_file">${wmx_param_file}</param>
      </hardware>

      <xacro:macro name="arm_joint" params="joint axis">
        <joint name="${joint}">
          <param name="axis">${axis}</param>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
        </joint>
      </xacro:macro>

      <xacro:arm_joint joint="joint1" axis="0"/>
      <xacro:arm_joint joint="joint2" axis="1"/>
      <xacro:arm_joint joint="joint3" axis="2"/>
      <xacro:arm_joint joint="joint4" axis="3"/>
      <xacro:arm_joint joint="joint5" axis="4"/>
      <xacro:arm_joint joint="joint6" axis="5"/>
    </ros2_control>

  </xacro:macro>
</robot>
