# Move the robot joints to/by a set of joint angles.
# Mirrors jog_arm_angle / jog_arm_angle_absolute / set_arm_angle_ptp of wmx_arm_server.
float64[] angle         # joint values [j1..jN] (rad for revolute, m for prismatic)
---
bool success            # true if the motion command was accepted
string message          # response or error description
int32 error_code        # raw WMX3 error code (0 on success)
float64[] result_angle  # resulting commanded joint values [j1..jN]
