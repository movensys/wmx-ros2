# Drive a lifecycle transition on the nodes managed by wmx_engine_node.

# Managed node name, e.g. "wmx_io_node". Empty targets every managed node.
string node_name

# configure | activate | deactivate | cleanup | shutdown | bringup | bringdown
#   bringup   = configure (if unconfigured) then activate
#   bringdown = deactivate (if active)
string transition
---
bool success
string message

# Nodes touched by this request and the lifecycle state each one ended up in.
string[] node_names
string[] states
