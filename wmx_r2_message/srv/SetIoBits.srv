# Writes scattered bits in one call: entry i is byte[i].bit[i] = value[i].
# All three arrays must be the same length.
int32[] byte    # output IO byte address per entry
int32[] bit     # bit index within that byte (0-7) per entry
int32[] value   # bit value to write per entry: 0 or 1
---
bool success    # true if the write succeeded
string message  # response or error description
